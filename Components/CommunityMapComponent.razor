@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text.Json
@using ZealousMindedPeopleGeo.Services
@using ZealousMindedPeopleGeo.Services.Repositories
@using ZealousMindedPeopleGeo.Models
@using ZealousMindedPeopleGeo.Services.GeoDataContainer
@inject IJSRuntime JSRuntime
@inject ILogger<CommunityMapComponent> Logger
@inject IOptions<ZealousMindedPeopleGeoOptions> Options
@inject IParticipantRepository ParticipantRepository
@inject IGeoDataContainerManager ContainerManager
@implements IAsyncDisposable

<div class="community-map-container">
    <div class="map-header">
        <h3>@Title</h3>
        @if (ShowParticipantsList)
        {
            <button type="button" class="participants-toggle"
                    aria-controls="@ParticipantsPanelId"
                    aria-expanded="@(_participantsListOpen ? "true" : "false")"
                    title="@(_participantsListOpen ? "Hide list" : "Show list")"
                    @onclick="ToggleParticipantsList">
                @ListTitle
                <span class="participants-toggle-count">@VisiblePoints.Count()</span>
                <span class="participants-toggle-icon" aria-hidden="true"></span>
            </button>
        }
        else
        {
            <div class="participants-count">
                Total Participants: @_points.Count
            </div>
        }
    </div>

    @if (ShowLegend && _palette.HasCategories)
    {
        @* Легенда — и фильтр: цвет подписан, поэтому категория не различается одним цветом. *@
        <div class="map-legend" role="group" aria-label="Categories">
            @foreach (var category in _palette.Categories)
            {
                var name = category.Name;
                <button type="button" class="map-legend-item"
                        aria-pressed="@(IsCategoryVisible(name) ? "true" : "false")"
                        title="@(IsCategoryVisible(name) ? "Hide" : "Show") @CategoryTitle(name)"
                        @onclick="() => ToggleCategoryAsync(name)">
                    <span class="map-legend-swatch" style="background: @category.Color"></span>
                    <span class="map-legend-name">@CategoryTitle(name)</span>
                    <span class="map-legend-count">@category.Count</span>
                </button>
            }
        </div>
    }

    @* Список стоит рядом с картой, а не поверх неё: в узком контейнере он уходит под карту. *@
    <div class="map-body" style="--zgl-map-height: @Height;">
        <div id="@MapId" class="map-canvas"></div>

        @if (ShowParticipantsList)
        {
            <aside id="@ParticipantsPanelId" class="participants-panel" aria-label="@ListTitle"
                   hidden="@(!_participantsListOpen)">
                <div class="participants-list">
                    @foreach (var point in VisiblePoints)
                    {
                        var place = PlaceOf(point);
                        <div class="participant-card" @onclick="() => ShowPointInfo(point)">
                            <div class="participant-avatar" style="background: @_palette.ColorFor(point)">
                                @MarkerLabel(point)
                            </div>
                            <div class="participant-info">
                                <div class="participant-name">@point.Title</div>
                                @if (!string.IsNullOrEmpty(point.Category))
                                {
                                    <div class="participant-location-details">@point.Category</div>
                                }
                                @if (place is not null)
                                {
                                    <div class="participant-location-details">@place</div>
                                }
                                @if (!string.IsNullOrEmpty(point.Description))
                                {
                                    <div class="participant-skills-preview">@Truncate(point.Description, 80)</div>
                                }
                            </div>
                        </div>
                    }
                    @if (!_isLoading && !VisiblePoints.Any())
                    {
                        <p class="participants-empty">
                            @(_points.Count == 0 ? "Nothing on the map yet" : "All categories are hidden")
                        </p>
                    }
                </div>
            </aside>
        }
    </div>

    @if (_isLoading)
    {
        <div class="map-loading-overlay">
            <div class="loading-spinner"></div>
            <div>Загрузка карты...</div>
        </div>
    }

    @if (_selectedPoint is not null)
    {
        var url = SafeUrl(_selectedPoint.Url);
        <div class="participant-modal-overlay" @onclick="CloseParticipantModal">
            <div class="participant-modal" role="dialog" aria-label="@_selectedPoint.Title" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h4>@_selectedPoint.Title</h4>
                    <button class="close-btn" aria-label="Close" @onclick="CloseParticipantModal">&times;</button>
                </div>
                <div class="modal-body">
                    @if (PointTemplate is not null)
                    {
                        @PointTemplate(_selectedPoint)
                    }
                    else
                    {
                        <div class="participant-details">
                            @if (!string.IsNullOrEmpty(_selectedPoint.Category))
                            {
                                <p class="point-category">
                                    <span class="map-legend-swatch" style="background: @_palette.ColorFor(_selectedPoint)"></span>
                                    @_selectedPoint.Category
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(_selectedPoint.Description))
                            {
                                <p class="point-description">@_selectedPoint.Description</p>
                            }
                            @foreach (var (label, value) in CardProperties(_selectedPoint))
                            {
                                <p><strong>@label:</strong> @value</p>
                            }
                            <p><strong>Coordinates:</strong> @_selectedPoint.Latitude.ToString("F6", CultureInfo.InvariantCulture), @_selectedPoint.Longitude.ToString("F6", CultureInfo.InvariantCulture)</p>
                            @if (url is not null)
                            {
                                <p><a href="@url" target="_blank" rel="noopener noreferrer">@url</a></p>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseParticipantModal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    }
</div>
