@using ZealousMindedPeopleGeo.Resources
@using System.Text.Json
@using System.Globalization
@inject IJSRuntime JSRuntime

<div class="globe-settings-panel">
    <div class="settings-header">
        <h5 class="mb-0">@Ui.SettingsTitle</h5>
        <div class="settings-actions">
            <button class="btn btn-sm btn-warning" @onclick="ApplySettingsAsync">✓ @Ui.SettingsApply</button>
            <button class="btn btn-sm btn-success" @onclick="SaveSettingsAsync">💾 @Ui.SettingsSave</button>
            <button class="btn btn-sm btn-primary" @onclick="LoadSettingsAsync">📂 @Ui.SettingsLoad</button>
            <button class="btn btn-sm btn-secondary" @onclick="ResetToDefaults">🔄 @Ui.SettingsReset</button>
        </div>
    </div>
    <div class="settings-body">
        <div class="accordion" id="settingsAccordion">

            <!-- Размеры -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(IsOpen("sizeSettings") ? null : "collapsed")" type="button" aria-expanded='@(IsOpen("sizeSettings") ? "true" : "false")' aria-controls="sizeSettings" @onclick='() => ToggleSection("sizeSettings")'>
                        📐 @Ui.SettingsSize
                    </button>
                </h2>
                <div id="sizeSettings" class="accordion-collapse collapse @(IsOpen("sizeSettings") ? "show" : null)">
                    <div class="accordion-body">
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsWidth(Settings.Width)</label>
                            <input type="range" class="form-range" min="400" max="2000" step="50" @bind="Settings.Width" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplySettingsAsync" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsHeight(Settings.Height)</label>
                            <input type="range" class="form-range" min="300" max="1500" step="50" @bind="Settings.Height" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplySettingsAsync" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Точки участников -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(IsOpen("pointSettings") ? null : "collapsed")" type="button" aria-expanded='@(IsOpen("pointSettings") ? "true" : "false")' aria-controls="pointSettings" @onclick='() => ToggleSection("pointSettings")'>
                        📍 @Ui.SettingsMarkers
                    </button>
                </h2>
                <div id="pointSettings" class="accordion-collapse collapse @(IsOpen("pointSettings") ? "show" : null)">
                    <div class="accordion-body">
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsMarkerSize(Settings.ParticipantPointSize)</label>
                            <input type="range" class="form-range" min="0.04" max="2.0" step="0.04" @bind="Settings.ParticipantPointSize" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplySettingsAsync" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsMarkerOffset(Settings.ParticipantPointOffset)</label>
                            <input type="range" class="form-range" min="0.01" max="0.2" step="0.01" @bind="Settings.ParticipantPointOffset" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplySettingsAsync" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsMarkerColor</label>
                            <input type="color" class="form-control form-control-color" @bind="Settings.ParticipantPointColor" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsMarkerOpacity(Settings.ParticipantMarkerOpacity)</label>
                            <input type="range" class="form-range" min="0.1" max="1.0" step="0.05" @bind="Settings.ParticipantMarkerOpacity" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplySettingsAsync" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsMarkerEdgeColor</label>
                            <input type="color" class="form-control form-control-color" @bind="Settings.HighlightedPointColor" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsRippleInterval(Settings.ParticipantMarkerRippleIntervalMs)</label>
                            <input type="range" class="form-range" min="500" max="5000" step="100" @bind="Settings.ParticipantMarkerRippleIntervalMs" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplySettingsAsync" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsRippleDuration(Settings.ParticipantMarkerRippleDurationMs)</label>
                            <input type="range" class="form-range" min="100" max="2000" step="50" @bind="Settings.ParticipantMarkerRippleDurationMs" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" @bind:after="ApplySettingsAsync" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Вращение -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(IsOpen("rotationSettings") ? null : "collapsed")" type="button" aria-expanded='@(IsOpen("rotationSettings") ? "true" : "false")' aria-controls="rotationSettings" @onclick='() => ToggleSection("rotationSettings")'>
                        🔄 @Ui.GlobeRotation
                    </button>
                </h2>
                <div id="rotationSettings" class="accordion-collapse collapse @(IsOpen("rotationSettings") ? "show" : null)">
                    <div class="accordion-body">
                        <div class="mb-2 form-check">
                            <input type="checkbox" class="form-check-input" id="autoRotate" @bind="Settings.AutoRotate" />
                            <label class="form-check-label" for="autoRotate">@Ui.SettingsAutoRotate</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsRotateSpeed(Settings.AutoRotateSpeed)</label>
                            <input type="range" class="form-range" min="0.1" max="2.0" step="0.1" @bind="Settings.AutoRotateSpeed" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Освещение -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(IsOpen("lightSettings") ? null : "collapsed")" type="button" aria-expanded='@(IsOpen("lightSettings") ? "true" : "false")' aria-controls="lightSettings" @onclick='() => ToggleSection("lightSettings")'>
                        💡 @Ui.SettingsLighting
                    </button>
                </h2>
                <div id="lightSettings" class="accordion-collapse collapse @(IsOpen("lightSettings") ? "show" : null)">
                    <div class="accordion-body">
                        <div class="mb-2 form-check">
                            <input type="checkbox" class="form-check-input" id="sunLightFollowCamera" @bind="Settings.SunLightFollowCamera" />
                            <label class="form-check-label" for="sunLightFollowCamera">@Ui.SettingsSunFollowsCamera</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsSunIntensity(Settings.SunLightIntensity)</label>
                            <input type="range" class="form-range" min="0.1" max="5.0" step="0.1" @bind="Settings.SunLightIntensity" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsSunDistance(Settings.SunLightDistance)</label>
                            <input type="range" class="form-range" min="2.0" max="12.0" step="0.5" @bind="Settings.SunLightDistance" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsSunColor</label>
                            <input type="color" class="form-control form-control-color" @bind="Settings.SunLightColor" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsAmbientIntensity(Settings.AmbientLightIntensity)</label>
                            <input type="range" class="form-range" min="0.1" max="5.0" step="0.1" @bind="Settings.AmbientLightIntensity" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsAmbientColor</label>
                            <input type="color" class="form-control form-control-color" @bind="Settings.AmbientLightColor" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsHemisphereIntensity(Settings.HemisphereLightIntensity)</label>
                            <input type="range" class="form-range" min="0.0" max="3.0" step="0.1" @bind="Settings.HemisphereLightIntensity" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Атмосфера и облака -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(IsOpen("atmosphereSettings") ? null : "collapsed")" type="button" aria-expanded='@(IsOpen("atmosphereSettings") ? "true" : "false")' aria-controls="atmosphereSettings" @onclick='() => ToggleSection("atmosphereSettings")'>
                        🌫️ @Ui.SettingsAtmosphereClouds
                    </button>
                </h2>
                <div id="atmosphereSettings" class="accordion-collapse collapse @(IsOpen("atmosphereSettings") ? "show" : null)">
                    <div class="accordion-body">
                        <div class="mb-2 form-check">
                            <input type="checkbox" class="form-check-input" id="enableAtmosphere" @bind="Settings.EnableAtmosphereGlow" />
                            <label class="form-check-label" for="enableAtmosphere">@Ui.SettingsEnableAtmosphere</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsAtmosphereColor</label>
                            <input type="color" class="form-control form-control-color" @bind="Settings.AtmosphereColor" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsAtmosphereOpacity(Settings.AtmosphereOpacity)</label>
                            <input type="range" class="form-range" min="0.0" max="1.0" step="0.05" @bind="Settings.AtmosphereOpacity" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                        <div class="mb-2 form-check">
                            <input type="checkbox" class="form-check-input" id="enableClouds" @bind="Settings.EnableClouds" />
                            <label class="form-check-label" for="enableClouds">@Ui.SettingsEnableClouds</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsCloudsOpacity(Settings.CloudsOpacity)</label>
                            <input type="range" class="form-range" min="0.0" max="1.0" step="0.05" @bind="Settings.CloudsOpacity" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsCloudsSpeed(Settings.CloudsSpeed)</label>
                            <input type="range" class="form-range" min="0.0" max="0.1" step="0.01" @bind="Settings.CloudsSpeed" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Камера -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(IsOpen("cameraSettings") ? null : "collapsed")" type="button" aria-expanded='@(IsOpen("cameraSettings") ? "true" : "false")' aria-controls="cameraSettings" @onclick='() => ToggleSection("cameraSettings")'>
                        📷 @Ui.SettingsCamera
                    </button>
                </h2>
                <div id="cameraSettings" class="accordion-collapse collapse @(IsOpen("cameraSettings") ? "show" : null)">
                    <div class="accordion-body">
                        <div class="mb-2 form-check">
                            <input type="checkbox" class="form-check-input" id="enableZoom" @bind="Settings.EnableZoom" />
                            <label class="form-check-label" for="enableZoom">@Ui.SettingsEnableZoom</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsMinZoom(Settings.MinZoom)</label>
                            <input type="range" class="form-range" min="1.02" max="2.0" step="0.01" @bind="Settings.MinZoom" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsMaxZoom(Settings.MaxZoom)</label>
                            <input type="range" class="form-range" min="2.0" max="10.0" step="0.5" @bind="Settings.MaxZoom" @bind:event="oninput" @bind:culture="CultureInfo.InvariantCulture" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Цвета -->
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button @(IsOpen("colorSettings") ? null : "collapsed")" type="button" aria-expanded='@(IsOpen("colorSettings") ? "true" : "false")' aria-controls="colorSettings" @onclick='() => ToggleSection("colorSettings")'>
                        🎨 @Ui.SettingsColors
                    </button>
                </h2>
                <div id="colorSettings" class="accordion-collapse collapse @(IsOpen("colorSettings") ? "show" : null)">
                    <div class="accordion-body">
                        <div class="mb-2">
                            <label class="form-label">@Ui.SettingsBackground</label>
                            <input type="color" class="form-control form-control-color" @bind="Settings.BackgroundColor" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- JSON Preview -->
        <div class="mt-3">
            <label class="form-label">@Ui.SettingsJson:</label>
            <textarea class="form-control font-monospace" rows="8" readonly>@JsonPreview</textarea>
        </div>
    </div>
</div>

@code {
    [Parameter] public string GlobeId { get; set; } = "default";
    [Parameter] public EventCallback<GlobeSettings> OnSettingsChanged { get; set; }

    private GlobeSettings Settings { get; set; } = new();

    // Аккордеон переключает Blazor: Bootstrap JS приложениям подключать не нужно.
    // Как в аккордеоне Bootstrap, открыта одна секция за раз.
    private string? _openSection = "sizeSettings";

    private bool IsOpen(string section) => _openSection == section;

    private void ToggleSection(string section) => _openSection = IsOpen(section) ? null : section;
    private string JsonPreview => JsonSerializer.Serialize(Settings, new JsonSerializerOptions { WriteIndented = true });
    private string ContainerId => $"globe-{GlobeId}";

    protected override void OnInitialized()
    {
        LoadDefaultSettings();
    }

    private void LoadDefaultSettings()
    {
        Settings = new GlobeSettings
        {
            Width = 800,
            Height = 600,
            BackgroundColor = "#000011",
            AtmosphereColor = "#4fb4ff",
            AtmosphereOpacity = 0.7,
            ParticipantPointSize = 0.06,
            ParticipantPointColor = "#24dce7",
            ParticipantPointOffset = 0.02,
            ParticipantMarkerOpacity = 0.72,
            ParticipantMarkerRippleIntervalMs = 2000,
            ParticipantMarkerRippleDurationMs = 500,
            HighlightedPointColor = "#e0fcff",
            AutoRotate = true,
            AutoRotateSpeed = 0.1,
            EnableMouseControls = true,
            EnableZoom = true,
            MinZoom = 1.03,
            MaxZoom = 4.0,
            EnableClouds = true,
            CloudsOpacity = 0.85,
            CloudsSpeed = 0.01,
            EnableAtmosphereGlow = true,
            SunLightFollowCamera = true,
            SunLightDistance = 6.0,
            SunLightIntensity = 2.6,
            SunLightColor = "#ffffff",
            AmbientLightIntensity = 0.3,
            AmbientLightColor = "#9db7d1",
            HemisphereLightIntensity = 0.25,
            HemisphereSkyColor = "#d8f1ff",
            HemisphereGroundColor = "#253042",
            AtmosphereLightIntensity = 0,
            AtmosphereLightColor = "#8fdcff"
        };
    }

    private async Task ApplySettingsAsync()
    {
        var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/_content/ZealousMindedPeopleGeo/js/community-globe.js");
        await module.InvokeVoidAsync("updateSettings", ContainerId, Settings);
        await OnSettingsChanged.InvokeAsync(Settings);
    }

    private async Task SaveSettingsAsync()
    {
        await ApplySettingsAsync();
        var json = JsonSerializer.Serialize(Settings, new JsonSerializerOptions { WriteIndented = true });
        var fileName = $"globe-settings-{GlobeId}-{DateTime.Now:yyyyMMdd-HHmmss}.json";

        await JSRuntime.InvokeVoidAsync("eval", $@"
            const blob = new Blob([{JsonSerializer.Serialize(json)}], {{ type: 'application/json' }});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = '{fileName}';
            a.click();
            URL.revokeObjectURL(url);
        ");
    }

    private async Task LoadSettingsAsync()
    {
        await JSRuntime.InvokeVoidAsync("eval", $@"
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.json';
            input.onchange = async (e) => {{
                const file = e.target.files[0];
                const text = await file.text();
                DotNet.invokeMethodAsync('ZealousMindedPeopleGeo', 'LoadSettingsFromJson', text);
            }};
            input.click();
        ");
    }

    [JSInvokable]
    public static void LoadSettingsFromJson(string json)
    {
        // Будет вызван из JavaScript
    }

    private async Task ResetToDefaults()
    {
        LoadDefaultSettings();
        await ApplySettingsAsync();
        StateHasChanged();
    }
    public class GlobeSettings
    {
        public int Width { get; set; }
        public int Height { get; set; }
        public string BackgroundColor { get; set; } = "#000011";
        public string AtmosphereColor { get; set; } = "#00aaff";
        public double AtmosphereOpacity { get; set; }
        public double ParticipantPointSize { get; set; }
        public string ParticipantPointColor { get; set; } = "#24dce7";
        public double ParticipantPointOffset { get; set; }
        public double ParticipantMarkerOpacity { get; set; }
        public int ParticipantMarkerRippleIntervalMs { get; set; }
        public int ParticipantMarkerRippleDurationMs { get; set; }
        public string HighlightedPointColor { get; set; } = "#e0fcff";
        public bool AutoRotate { get; set; }
        public double AutoRotateSpeed { get; set; }
        public bool EnableMouseControls { get; set; }
        public bool EnableZoom { get; set; }
        public double MinZoom { get; set; }
        public double MaxZoom { get; set; }
        public bool EnableClouds { get; set; }
        public double CloudsOpacity { get; set; }
        public double CloudsSpeed { get; set; }
        public bool EnableAtmosphereGlow { get; set; }
        public bool SunLightFollowCamera { get; set; } = true;
        public double SunLightDistance { get; set; }
        public double SunLightIntensity { get; set; }
        public string SunLightColor { get; set; } = "#ffffff";
        public double AmbientLightIntensity { get; set; }
        public string AmbientLightColor { get; set; } = "#9db7d1";
        public double HemisphereLightIntensity { get; set; }
        public string HemisphereSkyColor { get; set; } = "#d8f1ff";
        public string HemisphereGroundColor { get; set; } = "#253042";
        public double AtmosphereLightIntensity { get; set; }
        public string AtmosphereLightColor { get; set; } = "#8fdcff";
    }
}
