@page "/"

<PageTitle>@Site.TitleSuffix(Site.NavOverview)</PageTitle>

<section class="panel hero">
    <div>
        <div class="page-eyebrow">@Site.HomeEyebrow(ShowcaseInfo.LibraryVersion)</div>
        <h1 class="page-title">ZealousMindedPeopleGeo</h1>
        <p class="page-description">@Site.HomeDescription</p>
        <div class="hero-actions">
            <a class="button button-primary" href="map"><Icon Name="map" /> @Site.HomeOpenMap</a>
            <a class="button" href="globe"><Icon Name="globe" /> @Site.HomeOpenGlobe</a>
        </div>
    </div>
    <img class="hero-art" src="img/equal-earth.svg" width="550" height="272"
         alt="@Site.HomeHeroAlt" />
</section>

<section class="section">
    <h2 class="section-title">@Site.HomePages</h2>
    <div class="feature-grid">
        @foreach (var link in Pages)
        {
            <a class="panel feature-card" href="@link.Href">
                <span class="feature-icon"><Icon Name="@link.Icon" /></span>
                <h3>@link.Title</h3>
                <p>@link.Description</p>
                <span class="tag-list">
                    @foreach (var component in link.Components)
                    {
                        <span class="tag">@component</span>
                    }
                </span>
            </a>
        }
    </div>
</section>

<section class="section two-columns">
    <div class="panel">
        <h2 class="panel-title">@Site.HomeDataSets</h2>
        <table class="data-table">
            <thead>
                <tr><th>@Site.HomeDataSet</th><th>@Site.HomeDataSetDescription</th><th class="number">@Site.HomePointCount</th></tr>
            </thead>
            <tbody>
                @foreach (var set in DemoDataSets.All)
                {
                    <tr>
                        <td>@set.Title<br /><code>@set.Key</code></td>
                        <td>@set.Description</td>
                        <td class="number">@set.Create().Count</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="panel">
        <h2 class="panel-title">@Site.HomeRun</h2>
        <pre class="code-block">dotnet run --project hosts/ZealousMindedPeopleGeo.Showcase</pre>
        <p class="muted small">@Site.HomeRunWatch</p>
        <pre class="code-block">dotnet watch --project hosts/ZealousMindedPeopleGeo.Showcase</pre>
        <p class="muted small">@Site.HomeRunNote</p>
    </div>
</section>

@code {
    private sealed record PageLink(string Href, string Icon, string Title, string Description, string[] Components);

    // Свойство, а не поле: надписи — на языке текущего запроса.
    private static PageLink[] Pages => new PageLink[]
    {
        new("map", "map", Site.NavMap, Site.HomeMapDescription, new[] { "CommunityMapComponent" }),
        new("globe", "globe", Site.NavGlobe, Site.HomeGlobeDescription, new[] { "CommunityGlobeViewer" }),
        new("showcase", "grid", Site.NavShowcase, Site.HomeShowcaseDescription, new[] { "LibraryShowcaseComponent" }),
    };
}
