@page "/globe"
@using System.Globalization
@using ZealousMindedPeopleGeo.Services.GeoDataContainer
@inject IGeoDataContainerManager ContainerManager
@inject NavigationManager Navigation

<PageTitle>@Site.TitleSuffix(Site.NavGlobe)</PageTitle>

<PageHeader Eyebrow="CommunityGlobeViewer" Title="@Site.NavGlobe">
    <Description>
        @Site.GlobeDescriptionBefore <code>@ContainerId</code> @Site.GlobeDescriptionAfter
    </Description>
    <Meta>
        <span class="chip">@_dataSet.Title</span>
        <span class="chip">@Site.PointCount(_points.Count)</span>
    </Meta>
</PageHeader>

<div class="split">
    <section class="panel panel-flush">
        <CommunityGlobeViewer GlobeId="@GlobeId"
                              DataContainerId="@ContainerId"
                              DayNightMode="@(_dayNight ? GlobeDayNightMode.RealTime : GlobeDayNightMode.Off)"
                              Planet="@(_demoPlanet ? DemoPlanet : null)"
                              Width="900"
                              Height="640" />
    </section>

    <aside class="panel">
        <h2 class="panel-title">@Site.DataSet</h2>
        <div class="option-list">
            @foreach (var set in DemoDataSets.All)
            {
                <button type="button" class="option @(set.Key == _dataSet.Key ? "active" : null)"
                        aria-pressed="@(set.Key == _dataSet.Key)" @onclick="() => SelectDataSet(set.Key)">
                    <span class="option-title">@set.Title</span>
                    <span class="option-description">@set.Description</span>
                </button>
            }
        </div>

        <h2 class="panel-title">@Site.Lighting</h2>
        <div class="option-list">
            <button type="button" class="option @(!_dayNight ? "active" : null)" aria-pressed="@(!_dayNight)" @onclick="() => SelectLighting(false)">
                <span class="option-title">@Site.LightingDay</span>
                <span class="option-description">@Site.LightingDayDescription</span>
            </button>
            <button type="button" class="option @(_dayNight ? "active" : null)" aria-pressed="@_dayNight" @onclick="() => SelectLighting(true)">
                <span class="option-title">@Site.LightingRealTime</span>
                <span class="option-description">@Site.LightingRealTimeDescription</span>
            </button>
        </div>

        <h2 class="panel-title">@Site.Planet</h2>
        <div class="option-list">
            <button type="button" class="option @(!_demoPlanet ? "active" : null)" aria-pressed="@(!_demoPlanet)" @onclick="() => SelectPlanet(false)">
                <span class="option-title">@Site.PlanetEarth</span>
                <span class="option-description">@Site.PlanetEarthDescription</span>
            </button>
            <button type="button" class="option @(_demoPlanet ? "active" : null)" aria-pressed="@_demoPlanet" @onclick="() => SelectPlanet(true)">
                <span class="option-title">@Site.PlanetDemo</span>
                <span class="option-description">@Site.PlanetDemoDescription</span>
            </button>
        </div>

        <h2 class="panel-title">@Site.Categories</h2>
        <ul class="point-list">
            @foreach (var category in _palette.Categories)
            {
                <li>
                    <span><span class="swatch" style="background: @category.Color"></span>@(category.Name.Length == 0 ? Site.NoCategory : category.Name)</span>
                    <span>@category.Count</span>
                </li>
            }
        </ul>

        <h2 class="panel-title">@Site.Points</h2>
        <ul class="point-list">
            @foreach (var point in _points)
            {
                <li>
                    <span><span class="swatch" style="background: @_palette.ColorFor(point)"></span>@point.Title</span>
                    <span>@FormatCoordinates(point)</span>
                </li>
            }
        </ul>
    </aside>
</div>

@code {
    [SupplyParameterFromQuery(Name = "set")] public string? DataSetKey { get; set; }
    [SupplyParameterFromQuery(Name = "daynight")] public bool DayNight { get; set; }
    [SupplyParameterFromQuery(Name = "planet")] public string? PlanetKey { get; set; }

    // Выдуманная планета: карта поверхности сгенерирована шумом на сфере, своих облаков и огней нет.
    private static readonly GlobePlanet DemoPlanet = new()
    {
        DayTextureUrl = "img/demo-planet.jpg",
        Roughness = 0.85,
        AtmosphereColor = "#ffb070",
        AtmosphereOpacity = 0.45
    };

    private bool _dayNight;
    private bool _demoPlanet;

    private DemoDataSets.DataSetInfo _dataSet = DemoDataSets.All[0];
    private List<GeoPoint> _points = new();
    private GeoPointPalette _palette = GeoPointPalette.For(Array.Empty<GeoPoint>());

    private string GlobeId => $"showcase-globe-{_dataSet.Key}";
    private string ContainerId => $"showcase-globe-{_dataSet.Key}-data";

    protected override async Task OnInitializedAsync()
    {
        _dataSet = DemoDataSets.FindByKey(DataSetKey ?? "") ?? DemoDataSets.All[0];
        _dayNight = DayNight;
        _demoPlanet = PlanetKey == "demo";
        _points = _dataSet.Create();
        _palette = GeoPointPalette.For(_points);
        await ContainerManager.LoadPointsAsync(ContainerId, _points);
    }

    private void SelectDataSet(string key)
    {
        if (key != _dataSet.Key)
        {
            // Полная перезагрузка: при пересоздании глобус не освобождает WebGL-контекст.
            Navigation.NavigateTo(GlobeUrl(key, _dayNight, _demoPlanet), forceLoad: true);
        }
    }

    private void SelectLighting(bool dayNight)
    {
        if (dayNight != _dayNight)
        {
            Navigation.NavigateTo(GlobeUrl(_dataSet.Key, dayNight, _demoPlanet), forceLoad: true);
        }
    }

    private void SelectPlanet(bool demo)
    {
        if (demo != _demoPlanet)
        {
            Navigation.NavigateTo(GlobeUrl(_dataSet.Key, _dayNight, demo), forceLoad: true);
        }
    }

    private static string GlobeUrl(string set, bool dayNight, bool demoPlanet) =>
        $"globe?set={Uri.EscapeDataString(set)}" + (dayNight ? "&daynight=true" : "") + (demoPlanet ? "&planet=demo" : "");

    private static string FormatCoordinates(GeoPoint point) =>
        string.Create(CultureInfo.InvariantCulture, $"{point.Latitude:F2}, {point.Longitude:F2}");
}
