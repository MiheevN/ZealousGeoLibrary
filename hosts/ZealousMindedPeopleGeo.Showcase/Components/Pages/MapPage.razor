@page "/map"

<PageTitle>2D карта · ZealousGeo</PageTitle>

<PageHeader Eyebrow="CommunityMapComponent" Title="2D карта">
    <Description>
        Карта рисуется на Canvas без внешних картографических API. По умолчанию —
        равновеликая проекция Equal Earth, прежняя прямоугольная доступна опцией.
        Точки окрашены по категориям, легенда над картой скрывает и показывает их.
        Близкие маркеры сливаются в группы со счётчиком: клик приближает группу,
        а точки с одинаковыми координатами раскрываются веером.
        Набор данных и группировка меняются на лету, а при смене проекции или
        меридиана компонент создаётся заново.
    </Description>
    <Meta>
        <span class="chip">Точек: @_points.Count</span>
        <span class="chip">MapId <code>@MapId</code></span>
    </Meta>
</PageHeader>

<section class="panel toolbar" aria-label="Параметры карты">
    <div class="field">
        <span class="field-label">Проекция</span>
        <div class="segmented" role="group" aria-label="Проекция">
            @foreach (var (value, title) in Projections)
            {
                <button type="button" class="@Active(value == _projection)" aria-pressed="@(value == _projection)"
                        @onclick="() => _projection = value">@title</button>
            }
        </div>
    </div>

    <div class="field">
        <span class="field-label">Центральный меридиан</span>
        <div class="segmented" role="group" aria-label="Центральный меридиан">
            @foreach (var (value, title) in Meridians)
            {
                <button type="button" class="@Active(value == _centralMeridian)" aria-pressed="@(value == _centralMeridian)"
                        @onclick="() => _centralMeridian = value">@title</button>
            }
        </div>
    </div>

    <div class="field">
        <span class="field-label">Группировка</span>
        <div class="segmented" role="group" aria-label="Группировка">
            <button type="button" class="@Active(_clusterPoints)" aria-pressed="@_clusterPoints"
                    @onclick="() => _clusterPoints = true">Вкл</button>
            <button type="button" class="@Active(!_clusterPoints)" aria-pressed="@(!_clusterPoints)"
                    @onclick="() => _clusterPoints = false">Выкл</button>
        </div>
    </div>

    <div class="field">
        <span class="field-label">Набор данных</span>
        <div class="segmented" role="group" aria-label="Набор данных">
            @foreach (var set in DemoDataSets.All)
            {
                <button type="button" class="@Active(set.Key == _dataSet.Key)" aria-pressed="@(set.Key == _dataSet.Key)"
                        @onclick="() => SelectDataSet(set)">@set.Title</button>
            }
        </div>
    </div>
</section>

<CommunityMapComponent @key="MapId"
                       MapId="@MapId"
                       Points="_points"
                       Title="@_dataSet.Title"
                       ListTitle="Точки"
                       Projection="_projection"
                       CentralMeridian="_centralMeridian"
                       ClusterPoints="_clusterPoints"
                       Zoom="1"
                       Height="620px"
                       ShowParticipantsList="true" />

@code {
    private static readonly (MapProjection Value, string Title)[] Projections =
    {
        (MapProjection.EqualEarth, "Equal Earth"),
        (MapProjection.Equirectangular, "Прямоугольная"),
    };

    private static readonly (int Value, string Title)[] Meridians =
    {
        (-90, "−90° Америка"),
        (0, "0° Гринвич"),
        (60, "60° Азия"),
        (150, "150° Тихий океан"),
    };

    private MapProjection _projection = MapProjection.EqualEarth;
    private int _centralMeridian;
    private bool _clusterPoints = true;
    private DemoDataSets.DataSetInfo _dataSet = DemoDataSets.FindByKey("tech-hubs")!;
    private List<GeoPoint> _points = DemoDataSets.TechHubs();

    // Своя карта на каждую проекцию и меридиан: старая освобождается по своему MapId
    // асинхронно и не должна задеть новую. Набор данных в MapId не входит: новые точки
    // карта принимает без пересоздания.
    private string MapId =>
        $"showcase-map-{_projection.ToString().ToLowerInvariant()}-{(_centralMeridian < 0 ? "w" : "e")}{Math.Abs(_centralMeridian)}";

    private static string? Active(bool active) => active ? "active" : null;

    private void SelectDataSet(DemoDataSets.DataSetInfo set)
    {
        _dataSet = set;
        _points = set.Create();
    }
}
