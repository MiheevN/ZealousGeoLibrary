@page "/map"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@Site.TitleSuffix(Site.NavMap)</PageTitle>

<PageHeader Eyebrow="CommunityMapComponent" Title="@Site.NavMap">
    <Description>@Site.MapDescription</Description>
    <Meta>
        <span class="chip">@Site.PointCount(_points.Count)</span>
        <span class="chip">MapId <code>@MapId</code></span>
    </Meta>
</PageHeader>

<section class="panel toolbar" aria-label="@Site.MapOptions">
    <div class="field">
        <span class="field-label">@Site.MapProjection</span>
        <div class="segmented" role="group" aria-label="@Site.MapProjection">
            @foreach (var (value, title) in Projections)
            {
                <button type="button" class="@Active(value == _projection)" aria-pressed="@(value == _projection)"
                        @onclick="() => _projection = value">@title</button>
            }
        </div>
    </div>

    <div class="field">
        <span class="field-label">@Site.MapCentralMeridian</span>
        <div class="segmented" role="group" aria-label="@Site.MapCentralMeridian">
            @foreach (var (value, title) in Meridians)
            {
                <button type="button" class="@Active(value == _centralMeridian)" aria-pressed="@(value == _centralMeridian)"
                        @onclick="() => _centralMeridian = value">@title</button>
            }
        </div>
    </div>

    <div class="field">
        <span class="field-label">@Site.MapGrouping</span>
        <div class="segmented" role="group" aria-label="@Site.MapGrouping">
            <button type="button" class="@Active(_clusterPoints)" aria-pressed="@_clusterPoints"
                    @onclick="() => _clusterPoints = true">@Site.On</button>
            <button type="button" class="@Active(!_clusterPoints)" aria-pressed="@(!_clusterPoints)"
                    @onclick="() => _clusterPoints = false">@Site.Off</button>
        </div>
    </div>

    <div class="field">
        <span class="field-label">@Site.DataSet</span>
        <div class="segmented" role="group" aria-label="@Site.DataSet">
            @foreach (var set in DemoDataSets.All)
            {
                <button type="button" class="@Active(set.Key == _dataSet?.Key)" aria-pressed="@(set.Key == _dataSet?.Key)"
                        @onclick="() => SelectDataSet(set)">@set.Title</button>
            }
        </div>
    </div>

    <div class="field">
        <span class="field-label">GeoJSON</span>
        <div class="field-actions">
            @* Ссылка с data: URL скачивает файл без JavaScript. *@
            <a class="button button-small" href="@DownloadHref" download="@DownloadName">@Site.MapDownload</a>
            <label class="button button-small file-button">
                @Site.MapUpload
                <InputFile OnChange="ImportAsync" accept=".geojson,.json,application/geo+json" />
            </label>
        </div>
    </div>
</section>

@if (_importMessage is not null)
{
    <p class="import-status @(_importFailed ? "import-status-error" : null)" role="status">@_importMessage</p>
}

<CommunityMapComponent @key="MapId"
                       MapId="@MapId"
                       Points="_points"
                       Title="@_title"
                       ListTitle="@Site.MapListTitle"
                       Projection="_projection"
                       CentralMeridian="_centralMeridian"
                       ClusterPoints="_clusterPoints"
                       Zoom="1"
                       Height="620px"
                       ShowParticipantsList="true" />

@code {
    // Свойства, а не поля: надписи — на языке текущего запроса.
    private static (MapProjection Value, string Title)[] Projections => new[]
    {
        (MapProjection.EqualEarth, "Equal Earth"),
        (MapProjection.Equirectangular, Site.MapRectangular),
    };

    private static (int Value, string Title)[] Meridians => new[]
    {
        (-90, Site.MapMeridianAmerica),
        (0, Site.MapMeridianGreenwich),
        (60, Site.MapMeridianAsia),
        (150, Site.MapMeridianPacific),
    };

    private MapProjection _projection = MapProjection.EqualEarth;
    private int _centralMeridian;
    private bool _clusterPoints = true;
    // Больше этого файл GeoJSON не загружается: точки идут через соединение Blazor Server.
    private const long MaxImportBytes = 5 * 1024 * 1024;

    // null — точки загружены из файла, а не из демо-набора.
    private DemoDataSets.DataSetInfo? _dataSet = DemoDataSets.FindByKey("tech-hubs")!;
    private List<GeoPoint> _points = DemoDataSets.TechHubs();
    private string _title = DemoDataSets.FindByKey("tech-hubs")!.Title;
    private string? _downloadHref;
    private string? _importMessage;
    private bool _importFailed;

    // Своя карта на каждую проекцию и меридиан: старая освобождается по своему MapId
    // асинхронно и не должна задеть новую. Набор данных в MapId не входит: новые точки
    // карта принимает без пересоздания.
    private string MapId =>
        $"showcase-map-{_projection.ToString().ToLowerInvariant()}-{(_centralMeridian < 0 ? "w" : "e")}{Math.Abs(_centralMeridian)}";

    private static string? Active(bool active) => active ? "active" : null;

    // GeoJSON текущих точек; пересчитывается только при их смене.
    private string DownloadHref => _downloadHref ??=
        "data:application/geo+json;charset=utf-8," + Uri.EscapeDataString(GeoPointGeoJson.Write(_points));

    private string DownloadName => $"{_dataSet?.Key ?? "points"}.geojson";

    private void SelectDataSet(DemoDataSets.DataSetInfo set)
    {
        _dataSet = set;
        ShowPoints(set.Create(), set.Title);
        _importMessage = null;
    }

    private void ShowPoints(List<GeoPoint> points, string title)
    {
        _points = points;
        _title = title;
        _downloadHref = null;
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _importFailed = true;
        if (file.Size > MaxImportBytes)
        {
            _importMessage = Site.ImportTooLarge(file.Name);
            return;
        }

        GeoJsonReadResult read;
        try
        {
            await using var stream = file.OpenReadStream(MaxImportBytes);
            using var reader = new StreamReader(stream);
            read = GeoPointGeoJson.Read(await reader.ReadToEndAsync());
        }
        catch (JsonException)
        {
            _importMessage = Site.ImportNotGeoJson(file.Name);
            return;
        }

        if (read.Points.Count == 0)
        {
            _importMessage = read.SkippedCount > 0
                ? Site.ImportNoPointsReason(file.Name, read.Skipped[0])
                : Site.ImportNoPoints(file.Name);
            return;
        }

        _dataSet = null;
        ShowPoints(read.Points, Path.GetFileNameWithoutExtension(file.Name));
        _importFailed = false;
        _importMessage = read.SkippedCount == 0
            ? Site.ImportLoaded(read.Points.Count, file.Name)
            : Site.ImportLoadedSkipped(read.Points.Count, file.Name, read.SkippedCount, read.Skipped[0]);
    }
}
