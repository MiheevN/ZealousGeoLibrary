<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e1013" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    @* Манифест PWA из библиотеки: без него браузер не предлагает установку. *@
    <link rel="manifest" href="_content/ZealousMindedPeopleGeo/manifest.json" />
    <link rel="apple-touch-icon" href="_content/ZealousMindedPeopleGeo/icons/icon-192x192.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    @* Все стили библиотеки — одним файлом, после Bootstrap и до своих стилей. *@
    <link rel="stylesheet" href="_content/ZealousMindedPeopleGeo/css/zealous-geo.css" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui" role="alert">
        Произошла необработанная ошибка, подробности — в консоли браузера и логе хоста.
        <a href="." class="reload">Перезагрузить</a>
        <span class="dismiss" aria-label="Закрыть">✕</span>
    </div>

    <script src="_framework/blazor.web.js"></script>
</body>
</html>
